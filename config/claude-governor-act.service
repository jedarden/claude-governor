[Unit]
Description=Claude Governor - scale workers and manage alerts
Documentation=https://github.com/jedarden/claude-governor
After=network-online.target claude-governor-observe.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/cgov _act
Restart=always
RestartSec=10
Environment="PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Logging
StandardOutput=journal
StandardError=journal

# Acting shells out to worker/session commands and alert commands, but does
# not poll the usage API or run the token collector.
# OOM-safety (claudego-37232871): 512M was a fleet-wiping cap - this cgroup
# also hosts the tmux server and every spawned worker tree; 512M OOM-killed
# the whole cgroup on lab. Sized for the governor plus max_workers Sonnet
# trees, MemoryHigh throttling before any hard kill. Prefer isolating workers
# into a dedicated slice via launch_cmd so a governor OOM never touches them.
MemoryHigh=12G
MemoryMax=16G
CPUQuota=50%

[Install]
WantedBy=default.target
