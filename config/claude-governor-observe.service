[Unit]
Description=Claude Governor - observe usage and forecast capacity
Documentation=https://github.com/jedarden/claude-governor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/cgov _observe
Restart=always
RestartSec=10
Environment="PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Logging
StandardOutput=journal
StandardError=journal

# Observation performs API polling, collection, and forecasting but never
# launches or kills a worker and never fires an alert.
# OOM-safety (claudego-37232871): 512M was a fleet-wiping cap - this cgroup
# also hosts the tmux server and every spawned worker tree; 512M OOM-killed
# the whole cgroup on lab. Sized for the governor plus max_workers Sonnet
# trees, MemoryHigh throttling before any hard kill. Prefer isolating workers
# into a dedicated slice via launch_cmd so a governor OOM never touches them.
MemoryHigh=12G
MemoryMax=16G
CPUQuota=50%

[Install]
WantedBy=default.target
