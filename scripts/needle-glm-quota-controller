#!/usr/bin/env python3
"""Keep the NEEDLE GLM fleet paced against the live five-hour quota.

Fleet model is GLM-5.3-Flash since 2026-09-03 (GLM-4.7 was retired upstream and
is silently routed to it by Z.AI).

Input ownership: the five-hour quota sample (governor-state.json) is produced
by cgov -- the acting daemon (claude-governor.service), or the observe-only
pipeline (claude-governor-observe.service, `cgov _observe -i 300`) when the
daemon is deliberately stopped. If that sample goes stale (>15 min) or
disappears, this controller first takes a sample itself: `cgov poll` is a
read-only usage poll on the on-disk OAuth credentials and needs no daemon.
The self-sampled point is fed into this controller's own sample history like
any other and backfilled into governor-state.json (under cgov's state lock)
so the file's other consumers also see a fresh sample. Only if the self-sample
also fails does the controller degrade instead of failing: it keeps LOCAL_BASE
enabled and started, sheds at most one lab unit per pass (MIN_SCALE_INTERVAL_SECS
and operator masks still apply), records action='stale-hold-conservative' with
the sample age, and exits 0. Exit 1 is reserved for the controller's own local
failures, never for upstream data staleness; needle-zai-governor remains the
independent 429-pressure backstop for the expansion pool.

The canonical copy of this script is scripts/needle-glm-quota-controller in
the claude-governor repo; /home/coding/bin holds the deployed copy. Edit the
repo copy, then redeploy.

QUOTA_STATE, QUOTA_CONTROLLER_STATE, CGOV_BIN, QUOTA_LOCAL_UNITS and
QUOTA_LAB_UNITS are env-overridable so a verification run can point them at
copies and empty unit lists and exercise the full pacing logic without
touching real files or the real fleet.
"""

from __future__ import annotations

import json
import math
import os
import re
import subprocess
import sys
import tempfile
import time
from contextlib import suppress
from datetime import datetime, timezone
from pathlib import Path


def _env_units(name: str, default: list[str]) -> list[str]:
    """Unit lists are env-overridable (comma-separated); see module docstring."""
    override = os.environ.get(name)
    if override is None:
        return default
    return [unit.strip() for unit in override.split(",") if unit.strip()]


QUOTA_STATE = Path(
    os.environ.get("QUOTA_STATE", "/home/coding/.config/claude-governor/governor-state.json")
)
STATE_PATH = Path(
    os.environ.get(
        "QUOTA_CONTROLLER_STATE",
        "/home/coding/.local/state/needle-glm-quota-controller/state.json",
    )
)
CGOV_BIN = os.environ.get("CGOV_BIN", "")
TARGET_PERCENT = 98.0
SAMPLE_WINDOW_SECS = 60 * 60
MIN_SAMPLE_SECS = 20 * 60
MIN_SCALE_INTERVAL_SECS = 5 * 60
MAX_QUOTA_AGE_SECS = 15 * 60
POLL_TIMEOUT_SECS = 60
LOCK_WAIT_SECS = 10.0

LOCAL_BASE = _env_units(
    "QUOTA_LOCAL_UNITS",
    [
        "needle-worker@glm-armor.service",
        "needle-worker@glm-cgraph.service",
        "needle-worker@glm-loom.service",
        "needle-worker@glm-mta.service",
        "needle-worker@glm-needle.service",
        "needle-worker@glm-seam.service",
        "needle-worker@glm-spaxel.service",
    ],
)
# The public-project elastic pool (pdftract, bead-rs, CLASP, claude-print, and
# irreversible-command-gate) is owned by the standalone needle-zai-governor.
# Keeping it out of LOCAL_BASE prevents the quota and 429-rate controllers
# from fighting over the same units.

# Lab is the elastic public-project pool. Each worker has a distinct checkout
# and Explore disabled; ordering keeps core projects ahead of SDK follow-ons.
LAB_ELASTIC = _env_units(
    "QUOTA_LAB_UNITS",
    [
        "needle-worker@lab-pdftract.service",
        "needle-worker@lab-beadrs.service",
        "needle-worker@lab-needle.service",
        "needle-worker@lab-sigil.service",
        "needle-worker@lab-drawrace-public.service",
        "needle-worker@lab-gantry.service",
        "needle-worker@lab-miroir.service",
        "needle-worker@lab-pdftract-dotnet.service",
        "needle-worker@lab-pdftract-php.service",
        "needle-worker@lab-pdftract-ruby.service",
        "needle-worker@lab-pdftract-swift.service",
    ],
)

THROTTLE_RE = re.compile(
    r"(?:\b429\b|rate.?limit|too many requests|quota (?:exceeded|limit)|overloaded)",
    re.IGNORECASE,
)


def parse_time(value: str) -> datetime:
    return datetime.fromisoformat(value.replace("Z", "+00:00"))


def window_key(value: str) -> str:
    """The reset instant rounded down to whole seconds.

    resets_at carries the sampling instant's microsecond remainder, and each
    source (governor state file, cgov poll) samples at a different sub-second
    moment -- exact-string comparison would drop every stored sample each time
    the source changes or re-polls, so pace history could never accumulate
    across runs. Window boundaries land on whole seconds; rounding to them
    makes all samples of one five-hour window share a key.
    """
    try:
        return parse_time(value).replace(microsecond=0).isoformat()
    except (AttributeError, TypeError, ValueError):
        return ""


def run(host: str | None, args: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
    command = args if host is None else ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", host, *args]
    return subprocess.run(
        command,
        check=check,
        capture_output=True,
        text=True,
        timeout=60,
    )


def masked_units(host: str | None, units: list[str]) -> set[str]:
    """Units an operator has masked (symlinked to /dev/null).

    `systemctl enable` on a masked unit exits non-zero, and because the whole
    enable is one call, one masked unit aborts the controller before it starts
    anything at all -- the fleet then runs unmanaged against the quota. Masking
    is a deliberate operator act, so the right response is to leave those units
    alone and manage the rest; unmasking restores them here with no edit.
    """
    if not units:
        return set()
    result = run(host, ["systemctl", "--user", "is-enabled", *units], check=False)
    states = result.stdout.strip().splitlines()
    return {
        unit
        for unit, state in zip(units, states)
        if state.strip() == "masked"
    }


def systemctl(host: str | None, action: str, units: list[str]) -> None:
    if not units:
        return
    if action in {"enable", "disable", "start"}:
        skip = masked_units(host, units)
        if skip:
            print(
                f"needle-glm-quota-controller: skipping {len(skip)} masked unit(s) "
                f"on {action}: {', '.join(sorted(skip))}",
                file=sys.stderr,
            )
            units = [unit for unit in units if unit not in skip]
        if not units:
            return
    args = ["systemctl", "--user", action]
    if action in {"start", "stop"}:
        args.append("--no-block")
    run(host, [*args, *units])


def active_on_lab(units: list[str]) -> list[str]:
    active = []
    for unit in units:
        result = run("lab", ["systemctl", "--user", "is-active", unit], check=False)
        if result.stdout.strip() in {"active", "activating"}:
            active.append(unit)
    return active


def throttle_count() -> int:
    command = [
        "journalctl",
        "--user",
        "-u",
        "needle-worker@*.service",
        "--since",
        "-15 minutes",
        "--no-pager",
        "-o",
        "cat",
    ]
    count = 0
    for host in (None, "lab"):
        result = run(host, command, check=False)
        count += sum(1 for line in result.stdout.splitlines() if THROTTLE_RE.search(line))
    return count


def load_controller_state() -> dict:
    if not STATE_PATH.exists():
        return {"samples": [], "last_scale_at": 0.0}
    try:
        return json.loads(STATE_PATH.read_text())
    except (OSError, json.JSONDecodeError):
        return {"samples": [], "last_scale_at": 0.0}


def save_controller_state(state: dict) -> None:
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    temporary = STATE_PATH.with_suffix(".json.next")
    temporary.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n")
    temporary.replace(STATE_PATH)


def observed_slope(samples: list[dict], fallback: float) -> tuple[float, float]:
    if len(samples) < 2:
        return fallback, 0.0
    first = samples[0]
    last = samples[-1]
    elapsed = float(last["ts"]) - float(first["ts"])
    if elapsed < MIN_SAMPLE_SECS:
        return fallback, elapsed
    slope = (float(last["pct"]) - float(first["pct"])) / (elapsed / 3600.0)
    return slope, elapsed


def load_quota_sample(now: float) -> tuple[dict | None, float | None]:
    """The governor's quota sample, plus its age in seconds.

    Returns (None, age) when the sample is stale and (None, None) when it
    cannot be read at all -- both are upstream conditions (the producer, cgov,
    is down or retired), never controller errors, so the caller degrades to a
    conservative hold instead of exiting.
    """
    try:
        quota = json.loads(QUOTA_STATE.read_text())
        updated_at = parse_time(quota["updated_at"])
    except (OSError, ValueError, KeyError, TypeError):
        return None, None
    age = now - updated_at.timestamp()
    if age > MAX_QUOTA_AGE_SECS:
        return None, age
    return quota, age


def poll_quota_sample() -> tuple[float, datetime] | None:
    """Self-sample the five-hour window straight from the usage API.

    Used when the governor's state file is stale, unreadable or unusable:
    `cgov poll --format json` is a read-only usage poll on the on-disk OAuth
    credentials and needs no daemon. The absolute path is tried first because
    the systemd user manager PATH carries no ~/.local/bin. Returns None on any
    failure, timeout, or a stale:true answer; the caller then falls through to
    the conservative hold instead of acting blind.
    """
    candidates = [CGOV_BIN] if CGOV_BIN else ["/home/coding/.local/bin/cgov", "cgov"]
    for candidate in candidates:
        try:
            result = subprocess.run(
                [candidate, "poll", "--format", "json"],
                capture_output=True,
                text=True,
                timeout=POLL_TIMEOUT_SECS,
            )
        except subprocess.TimeoutExpired:
            print(
                f"needle-glm-quota-controller: cgov poll timed out after {POLL_TIMEOUT_SECS}s",
                file=sys.stderr,
            )
            return None
        except OSError:
            continue  # candidate missing or not executable: try the next
        if result.returncode != 0:
            print(
                f"needle-glm-quota-controller: cgov poll failed (rc={result.returncode}): "
                f"{result.stderr.strip()[:200]}",
                file=sys.stderr,
            )
            return None
        try:
            payload = json.loads(result.stdout)
            if payload.get("stale"):
                print(
                    "needle-glm-quota-controller: cgov poll reports its own sample stale",
                    file=sys.stderr,
                )
                return None
            percent = float(payload["five_hour"]["utilization"])
            reset_at = parse_time(payload["five_hour"]["resets_at"])
        except (KeyError, TypeError, ValueError, json.JSONDecodeError) as error:
            print(
                f"needle-glm-quota-controller: unusable cgov poll output: {error}",
                file=sys.stderr,
            )
            return None
        return percent, reset_at
    print("needle-glm-quota-controller: no usable cgov binary found", file=sys.stderr)
    return None


def state_lock_is_stale(lock_path: Path) -> bool:
    """Mirror of cgov's state_lock_is_stale (src/state.rs, Linux): a lock whose
    recorded owner is dead is stale immediately; one with no readable owner is
    conservatively stale after a minute."""
    owner: int | None
    try:
        owner = int(lock_path.read_text().strip())
    except (OSError, ValueError):
        owner = None
    if owner is not None:
        return not Path(f"/proc/{owner}").exists()
    try:
        return time.time() - lock_path.stat().st_mtime > 60.0
    except OSError:
        return True


def acquire_state_lock():
    """cgov's create-new PID lockfile protocol (state.rs with_state_lock), so
    the backfill cannot splice against a concurrent observe-cycle merge.

    Returns an open lock-file handle the caller must close-and-unlink when its
    transaction ends, or None when the lock stayed busy; the backfill is
    best-effort, so None means skip it, not fail.
    """
    lock_path = QUOTA_STATE.with_suffix(".json.lock")
    started = time.monotonic()
    while time.monotonic() - started < LOCK_WAIT_SECS:
        try:
            handle = os.open(lock_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        except FileExistsError:
            if state_lock_is_stale(lock_path):
                with suppress(OSError):
                    os.unlink(lock_path)
            time.sleep(0.05)
            continue
        except OSError:
            return None
        lock = os.fdopen(handle, "w")
        lock.write(f"{os.getpid()}\n")
        lock.flush()
        return lock
    return None


def backfill_quota_state(percent: float, reset_at: datetime) -> None:
    """Publish the self-sampled point into the governor's state file so its
    other consumers see a fresh sample too: updated_at plus the two five-hour
    fields this controller itself consumes. Atomic replace, mode preserved,
    under cgov's state lock. Skipped -- never fatal, the controller's own
    pacing already holds the sample -- when the file is gone or the lock stays
    busy; a live governor simply overwrites these fields on its next observe
    cycle.
    """
    lock = acquire_state_lock()
    if lock is None:
        print(
            "needle-glm-quota-controller: state lock busy; skipping backfill",
            file=sys.stderr,
        )
        return
    try:
        quota = json.loads(QUOTA_STATE.read_text())
        mode = QUOTA_STATE.stat().st_mode & 0o777
        quota["updated_at"] = datetime.now(timezone.utc).isoformat()
        usage = quota.setdefault("usage", {})
        usage["five_hour_pct"] = percent
        usage["five_hour_resets_at"] = reset_at.isoformat()
        fd, temporary_name = tempfile.mkstemp(
            dir=str(QUOTA_STATE.parent), prefix=".governor-state.", suffix=".tmp"
        )
        try:
            with os.fdopen(fd, "w") as handle:
                json.dump(quota, handle, indent=2, sort_keys=True)
                handle.write("\n")
            os.chmod(temporary_name, mode)
            os.replace(temporary_name, QUOTA_STATE)
        except OSError:
            with suppress(OSError):
                os.unlink(temporary_name)
    except (OSError, AttributeError, TypeError, ValueError):
        print(
            "needle-glm-quota-controller: backfill skipped (state file unreadable)",
            file=sys.stderr,
        )
    finally:
        lock.close()
        with suppress(OSError):
            os.unlink(QUOTA_STATE.with_suffix(".json.lock"))


def conservative_hold(now: float, state: dict, sample_age: float | None) -> int:
    """Degrade posture for stale or missing quota input.

    Pacing needs a live sample, so nothing scales up here. The base fleet
    stays enabled and started (masked units excluded, as everywhere), and the
    lab elastic pool sheds at most one unit per pass -- honoring
    MIN_SCALE_INTERVAL_SECS -- so the failure direction is less quota pressure
    rather than more. The independent needle-zai-governor keeps managing the
    expansion pool by 429 pressure, so a hold never leaves the fleet
    unmanaged.
    """
    masked_lab = masked_units("lab", LAB_ELASTIC)
    lab_pool = [unit for unit in LAB_ELASTIC if unit not in masked_lab]
    active_lab = active_on_lab(lab_pool)
    throttles = throttle_count()
    since_scale = now - float(state.get("last_scale_at", 0.0))

    systemctl(None, "enable", LOCAL_BASE)
    systemctl(None, "start", LOCAL_BASE)

    if active_lab and since_scale >= MIN_SCALE_INTERVAL_SECS:
        victim = active_lab[-1]
        systemctl("lab", "disable", [victim])
        systemctl("lab", "stop", [victim])
        active_lab.remove(victim)
        state["last_scale_at"] = now

    state.update(
        {
            "last_run_at": now,
            "quota_sample_age_secs": sample_age,
            "lab_workers": len(active_lab),
            "throttle_lines_15m": throttles,
            "action": "stale-hold-conservative",
        }
    )
    save_controller_state(state)
    print(
        json.dumps(
            {
                "action": "stale-hold-conservative",
                "five_hour_pct": None,
                "hours_remaining": None,
                "observed_pct_per_hour": None,
                "required_pct_per_hour": None,
                "quota_sample_age_secs": None if sample_age is None else round(sample_age),
                "local_base": len(LOCAL_BASE),
                "lab_active": len(active_lab),
                "throttle_lines_15m": throttles,
            },
            sort_keys=True,
        )
    )
    return 0


def main() -> int:
    now = time.time()
    state = load_controller_state()
    quota, sample_age = load_quota_sample(now)
    percent = reset_at = None
    if quota is not None:
        usage = quota["usage"]
        try:
            percent = float(usage["five_hour_pct"])
            reset_at = parse_time(usage["five_hour_resets_at"])
        except (KeyError, TypeError, ValueError):
            # A structurally unusable sample is the same upstream failure
            # class as a stale one: fall through to a live self-sample.
            percent = reset_at = None
    self_sampled = percent is None
    if self_sampled:
        sample = poll_quota_sample()
        if sample is None:
            return conservative_hold(now, state, sample_age)
        percent, reset_at = sample
        backfill_quota_state(percent, reset_at)

    hours_remaining = max((reset_at - datetime.now(timezone.utc)).total_seconds() / 3600.0, 1 / 60)
    required = max(0.0, TARGET_PERCENT - percent) / hours_remaining
    fleet_ema = ((quota or {}).get("burn_rate") or {}).get("fleet_pct_hr_ema") or {}
    fallback = float(fleet_ema.get("five_hour") or 0.0)

    current_window = window_key(reset_at.isoformat())
    samples = [
        sample
        for sample in state.get("samples", [])
        if now - float(sample.get("ts", 0)) <= SAMPLE_WINDOW_SECS
        and window_key(sample.get("reset_at")) == current_window
    ]
    samples.append({"ts": now, "pct": percent, "reset_at": current_window})
    state["samples"] = samples
    slope, sample_elapsed = observed_slope(samples, fallback)

    masked_lab = masked_units("lab", LAB_ELASTIC)
    lab_pool = [unit for unit in LAB_ELASTIC if unit not in masked_lab]
    active_lab = active_on_lab(lab_pool)
    throttles = throttle_count()
    since_scale = now - float(state.get("last_scale_at", 0.0))
    action = "hold"

    if percent >= TARGET_PERCENT:
        systemctl("lab", "disable", active_lab)
        systemctl("lab", "stop", active_lab)
        systemctl(None, "stop", LOCAL_BASE)
        active_lab = []
        action = "quota-target-reached"
    else:
        systemctl(None, "enable", LOCAL_BASE)
        systemctl(None, "start", LOCAL_BASE)

        if throttles >= 3 and active_lab and since_scale >= MIN_SCALE_INTERVAL_SECS:
            victim = active_lab[-1]
            systemctl("lab", "disable", [victim])
            systemctl("lab", "stop", [victim])
            active_lab.remove(victim)
            state["last_scale_at"] = now
            action = f"scale-down-throttling:{victim}"
        elif (
            slope < required * 0.90
            and len(active_lab) < len(lab_pool)
            and since_scale >= MIN_SCALE_INTERVAL_SECS
        ):
            current_workers = len(LOCAL_BASE) + len(active_lab)
            if slope > 0:
                desired_total = math.ceil(current_workers * required / slope)
            else:
                desired_total = len(LOCAL_BASE) + len(LAB_ELASTIC)
            desired_lab = min(
                len(lab_pool),
                max(len(active_lab) + 1, desired_total - len(LOCAL_BASE)),
            )
            candidates = [
                unit for unit in lab_pool if unit not in active_lab
            ][: desired_lab - len(active_lab)]
            systemctl("lab", "enable", candidates)
            systemctl("lab", "start", candidates)
            active_lab.extend(candidates)
            state["last_scale_at"] = now
            action = f"scale-up-behind-pace:{len(candidates)}"
        elif (
            sample_elapsed >= MIN_SAMPLE_SECS
            and slope > required * 1.35
            and active_lab
            and since_scale >= MIN_SCALE_INTERVAL_SECS
        ):
            victim = active_lab[-1]
            systemctl("lab", "disable", [victim])
            systemctl("lab", "stop", [victim])
            active_lab.remove(victim)
            state["last_scale_at"] = now
            action = f"scale-down-ahead-of-pace:{victim}"

    if self_sampled and action == "hold":
        # No scaling fired; say the run held on a sample it took itself.
        action = "stale-self-sampled"

    state.update(
        {
            "last_run_at": now,
            "five_hour_pct": percent,
            "reset_at": reset_at.isoformat(),
            "observed_pct_per_hour": slope,
            "required_pct_per_hour": required,
            "lab_workers": len(active_lab),
            "throttle_lines_15m": throttles,
            "action": action,
            "sample_source": "self-poll" if self_sampled else "governor-state",
        }
    )
    save_controller_state(state)
    print(
        json.dumps(
            {
                "action": action,
                "five_hour_pct": percent,
                "hours_remaining": round(hours_remaining, 2),
                "observed_pct_per_hour": round(slope, 2),
                "required_pct_per_hour": round(required, 2),
                "local_base": len(LOCAL_BASE),
                "lab_active": len(active_lab),
                "throttle_lines_15m": throttles,
                "sample_source": "self-poll" if self_sampled else "governor-state",
            },
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as error:
        print(f"needle-glm-quota-controller: {error}", file=sys.stderr)
        sys.exit(1)
