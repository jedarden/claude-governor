--- CONSTRUCTED QUERY ---
SELECT COUNT(DISTINCT i.id)
  FROM issues i
  LEFT JOIN labels l ON l.issue_id = i.id
  WHERE i.status = 'open'
  AND i.assignee IS NULL
  AND NOT EXISTS (SELECT 1 FROM labels WHERE issue_id = i.id AND label IN ('deferred', 'human', 'blocked') )
