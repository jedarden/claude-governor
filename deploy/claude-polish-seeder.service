# cgov polish-loop seeder — one pass. Paired with claude-polish-seeder.timer.
# Install: cp deploy/claude-polish-seeder.{service,timer} ~/.config/systemd/user/
#          systemctl --user daemon-reload
#          systemctl --user enable --now claude-polish-seeder.timer
[Unit]
Description=cgov polish-loop seeder (top up the polish queue)

[Service]
Type=oneshot
# systemd --user's default PATH on NixOS is just the systemd unit's own nix
# store bin/ (no /run/current-system/sw/bin) — "env bash" fails with exit 127
# without this override. Needed by any user unit that shells out.
Environment=PATH=/run/current-system/sw/bin:%h/.local/bin:%h/.cargo/bin:/usr/bin:/bin
ExecStart=%h/claude-governor/scripts/polish-seeder.sh
# Push produced beads to the remote (Forgejo) each pass, best-effort — a non-ff
# rejection just leaves them committed locally to push on a later pass.
Environment=CGOV_POLISH_PUSH=1
# Other overrides if needed:
# Environment=CGOV_POLISH_LOW_WATER=5 CGOV_POLISH_TARGETS=%h/.config/claude-governor/polish-targets.txt
